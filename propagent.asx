  "South Guildford",
  "Wattle Grove",
  // South Coast
  "Baldivis",
  "Bertram",
  "Cooloongup",
  "Kwinana",
  "Mandurah",
  "Meadow Springs",
  "Port Kennedy",
  "Rockingham",
  "Secret Harbour",
  "Safety Bay",
  "Singleton",
  "Waikiki",
  "Wellard",
].sort((a, b) => a === "Any suburb" ? -1 : b === "Any suburb" ? 1 : a.localeCompare(b));

function PropertyCard({ prop, index }) {
  const [imgError, setImgError] = useState(false);
  const formatPrice = (p) => {
    if (!p || p === "N/A") return "Contact agent";
    return p;
  };

  const hasImage = prop.imageUrl && prop.imageUrl !== "N/A" && prop.imageUrl !== null && !imgError;

  return (
    <div
      style={{
        background: "var(--color-background-primary)",
        border: "0.5px solid var(--color-border-tertiary)",
        borderRadius: "var(--border-radius-lg)",
        marginBottom: "0.75rem",
        overflow: "hidden",
        animation: `fadeIn 0.3s ease ${index * 0.08}s both`,
      }}
    >
      {hasImage ? (
        <div style={{ position: "relative", width: "100%", height: "200px", background: "var(--color-background-secondary)" }}>
          <img
            src={prop.imageUrl}
            alt={`Property at ${prop.address}`}
            onError={() => setImgError(true)}
            style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }}
          />
          <div style={{
            position: "absolute", bottom: 0, left: 0, right: 0,
            background: "linear-gradient(transparent, rgba(0,0,0,0.6))",
            padding: "32px 14px 10px",
          }}>
            <p style={{ fontWeight: 500, fontSize: "15px", margin: "0 0 2px", color: "#fff" }}>{prop.address}</p>
            <p style={{ fontSize: "13px", color: "rgba(255,255,255,0.8)", margin: 0 }}>{prop.suburb} · {prop.propertyType}</p>
          </div>
          <div style={{ position: "absolute", top: "10px", right: "10px", textAlign: "right" }}>
            <span style={{
              display: "block",
              background: "rgba(0,0,0,0.6)",
              color: "#fff",
              fontWeight: 500,
              fontSize: "14px",
              padding: "4px 10px",
              borderRadius: "var(--border-radius-md)",
              marginBottom: "4px",
            }}>{formatPrice(prop.price)}</span>
            {prop.source && (
              <span style={{
                fontSize: "11px",
                background: "var(--color-background-info)",
                color: "var(--color-text-info)",
                padding: "2px 8px",
                borderRadius: "var(--border-radius-md)",
              }}>{prop.source}</span>
            )}
          </div>
        </div>
      ) : (
        <div style={{
          width: "100%", height: "110px",
          background: "var(--color-background-secondary)",
          display: "flex", alignItems: "center", justifyContent: "center",
          borderBottom: "0.5px solid var(--color-border-tertiary)",
        }}>
          <i className="ti ti-home" style={{ fontSize: "32px", color: "var(--color-border-secondary)" }} aria-hidden="true" />
        </div>
      )}

      <div style={{ padding: "1rem 1.25rem" }}>
        {!hasImage && (
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: "8px" }}>
            <div style={{ flex: 1 }}>
              <p style={{ fontWeight: 500, fontSize: "15px", margin: "0 0 2px", color: "var(--color-text-primary)" }}>
                {prop.address}
              </p>
              <p style={{ fontSize: "13px", color: "var(--color-text-secondary)", margin: 0 }}>
                {prop.suburb} · {prop.propertyType}
              </p>
            </div>
            <div style={{ textAlign: "right", marginLeft: "12px" }}>
              <p style={{ fontWeight: 500, fontSize: "15px", margin: "0 0 2px", color: "var(--color-text-primary)" }}>
                {formatPrice(prop.price)}
              </p>
              {prop.source && (
                <span style={{
                  fontSize: "11px",
                  background: "var(--color-background-info)",
                  color: "var(--color-text-info)",
                  padding: "2px 8px",
                  borderRadius: "var(--border-radius-md)",
                }}>{prop.source}</span>
              )}
            </div>
          </div>
        )}

      <div style={{
        display: "grid",
        gridTemplateColumns: "repeat(3, 1fr)",
        gap: "8px",
        margin: "12px 0",
      }}>
        {[
          { icon: "ti-bed", label: "Bedrooms", value: prop.bedrooms },
          { icon: "ti-bath", label: "Bathrooms", value: prop.bathrooms },
          { icon: "ti-car", label: "Car parks", value: prop.carparks },
        ].map((stat) => (
          <div key={stat.label} style={{
            background: "var(--color-background-secondary)",
            borderRadius: "var(--border-radius-md)",
            padding: "8px 10px",
            textAlign: "center",
          }}>
            <i className={`ti ${stat.icon}`} style={{ fontSize: "16px", color: "var(--color-text-secondary)" }} aria-hidden="true" />
            <p style={{ fontSize: "18px", fontWeight: 500, margin: "2px 0 0", color: "var(--color-text-primary)" }}>{stat.value}</p>
            <p style={{ fontSize: "11px", color: "var(--color-text-secondary)", margin: 0 }}>{stat.label}</p>
          </div>
        ))}
      </div>

      <div style={{
        display: "grid",
        gridTemplateColumns: "repeat(2, 1fr)",
        gap: "8px",
        marginBottom: "10px",
      }}>
        {[
          { label: "Land size", value: prop.landSize },
          { label: "Built-up", value: prop.houseSize },
          { label: "Est. monthly", value: prop.estimatedMonthly },
          { label: "Price range", value: prop.priceMin && prop.priceMax && prop.priceMin !== "N/A" ? `${prop.priceMin} – ${prop.priceMax}` : "N/A" },
        ].map((d) => (
          <div key={d.label} style={{ fontSize: "13px" }}>
            <span style={{ color: "var(--color-text-secondary)" }}>{d.label}: </span>
            <span style={{ color: "var(--color-text-primary)", fontWeight: 500 }}>{d.value || "N/A"}</span>
          </div>
        ))}
      </div>

      {prop.description && (
        <p style={{ fontSize: "13px", color: "var(--color-text-secondary)", margin: "8px 0 10px", lineHeight: 1.5 }}>
          {prop.description}
        </p>
      )}

      {prop.url && prop.url !== "N/A" && (
        <a
          href={prop.url}
          style={{
            fontSize: "13px",
            color: "var(--color-text-info)",
            textDecoration: "none",
            display: "inline-flex",
            alignItems: "center",
            gap: "4px",
          }}
          target="_blank"
          rel="noopener noreferrer"
        >
          View listing <i className="ti ti-external-link" style={{ fontSize: "13px" }} aria-hidden="true" />
        </a>
      )}
      </div>
    </div>
  );
}

function StatusLine({ text }) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: "8px", padding: "10px 0", color: "var(--color-text-secondary)", fontSize: "14px" }}>
      <div style={{
        width: "14px", height: "14px", borderRadius: "50%",
        border: "2px solid var(--color-border-secondary)",
        borderTopColor: "var(--color-text-secondary)",
        animation: "spin 0.8s linear infinite",
        flexShrink: 0,
      }} />
      {text}
    </div>
  );
}

export default function PerthPropertyAgent() {
  const [suburb, setSuburb] = useState("Any suburb");
  const [budget, setBudget] = useState("any");
  const [properties, setProperties] = useState([]);
  const [loading, setLoading] = useState(false);
  const [statusMsg, setStatusMsg] = useState("");
  const [error, setError] = useState("");
  const [searched, setSearched] = useState(false);
  const abortRef = useRef(null);

  const buildPrompt = () => {
    const suburbPart = suburb !== "Any suburb" ? ` in ${suburb}` : " across Perth";
    const budgetPart = budget !== "any" ? ` with a maximum price of $${Number(budget).toLocaleString()}` : "";
    return `Search realestate.com.au for properties${suburbPart} in Perth, WA${budgetPart} that have 4 or more bedrooms, 2 or more bathrooms, and 2 or more car parks. Then look up property.com.au for land size, built-up area, estimated monthly repayments, and price range estimates for those properties. Return the results as a JSON array only.`;
  };

  const search = async () => {
    setLoading(true);
    setError("");
    setProperties([]);
    setSearched(true);
    setStatusMsg("Searching realestate.com.au for Perth properties…");

    try {
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 4000,
          system: SYSTEM_PROMPT,
          tools: [{ type: "web_search_20250305", name: "web_search" }],
          messages: [{ role: "user", content: buildPrompt() }],
        }),
      });

      if (!response.ok) throw new Error(`API error: ${response.status}`);

      const data = await response.json();
      setStatusMsg("Processing property details…");

      const textBlocks = (data.content || [])
        .filter((b) => b.type === "text")
        .map((b) => b.text)
        .join("");

      const cleaned = textBlocks.replace(/```json|```/g, "").trim();
      const startIdx = cleaned.indexOf("[");
      const endIdx = cleaned.lastIndexOf("]");

      if (startIdx === -1 || endIdx === -1) throw new Error("No property data returned. Try a different suburb or price range.");

      const parsed = JSON.parse(cleaned.slice(startIdx, endIdx + 1));
      setProperties(parsed);
    } catch (err) {
      setError(err.message || "Something went wrong. Please try again.");
    } finally {
      setLoading(false);
      setStatusMsg("");
    }
  };

  return (
    <>
      <style>{`
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes spin { to { transform: rotate(360deg); } }
      `}</style>

      <h2 className="sr-only">Perth Property Search Agent</h2>

      <div style={{ padding: "1.5rem 0 1rem" }}>
        <div style={{ display: "flex", alignItems: "center", gap: "10px", marginBottom: "4px" }}>
          <i className="ti ti-building-skyscraper" style={{ fontSize: "20px", color: "var(--color-text-secondary)" }} aria-hidden="true" />
          <p style={{ fontWeight: 500, fontSize: "18px", margin: 0, color: "var(--color-text-primary)" }}>Perth property search</p>
        </div>
        <p style={{ fontSize: "14px", color: "var(--color-text-secondary)", margin: "0 0 1.25rem 30px" }}>
          4+ beds · 2+ baths · 2+ car parks — sourced from realestate.com.au &amp; property.com.au
        </p>

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr auto", gap: "10px", alignItems: "end" }}>
          <div>
            <label style={{ fontSize: "12px", color: "var(--color-text-secondary)", display: "block", marginBottom: "4px" }}>Suburb</label>
            <select
              value={suburb}
              onChange={(e) => setSuburb(e.target.value)}
              style={{ width: "100%" }}
            >
              {SUBURB_OPTIONS.map((s) => <option key={s}>{s}</option>)}
            </select>
          </div>
          <div>
            <label style={{ fontSize: "12px", color: "var(--color-text-secondary)", display: "block", marginBottom: "4px" }}>Max budget</label>
            <select
              value={budget}
              onChange={(e) => setBudget(e.target.value)}
              style={{ width: "100%" }}
            >
              {Object.entries(BUDGET_LABELS).map(([v, l]) => <option key={v} value={v}>{l}</option>)}
            </select>
          </div>
          <button
            onClick={search}
            disabled={loading}
            style={{ opacity: loading ? 0.6 : 1, cursor: loading ? "not-allowed" : "pointer", whiteSpace: "nowrap" }}
          >
            {loading ? "Searching…" : "Search ↗"}
          </button>
        </div>

        {loading && <StatusLine text={statusMsg} />}
        {error && (
          <div style={{ marginTop: "12px", padding: "10px 14px", background: "var(--color-background-danger)", borderRadius: "var(--border-radius-md)", fontSize: "14px", color: "var(--color-text-danger)" }}>
            <i className="ti ti-alert-circle" style={{ fontSize: "15px", marginRight: "6px", verticalAlign: "-2px" }} aria-hidden="true" />
            {error}
          </div>
        )}
      </div>

      {properties.length > 0 && (
        <div>
          <div style={{ borderTop: "0.5px solid var(--color-border-tertiary)", paddingTop: "1rem", marginBottom: "0.75rem", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
            <p style={{ fontWeight: 500, fontSize: "15px", margin: 0, color: "var(--color-text-primary)" }}>
              {properties.length} {properties.length === 1 ? "property" : "properties"} found
            </p>
            <span style={{ fontSize: "12px", color: "var(--color-text-secondary)" }}>
              {suburb !== "Any suburb" ? suburb : "Perth"}{budget !== "any" ? ` · max $${Number(budget).toLocaleString()}` : ""}
            </span>
          </div>
          {properties.map((prop, i) => <PropertyCard key={i} prop={prop} index={i} />)}
        </div>
      )}

      {searched && !loading && properties.length === 0 && !error && (
        <div style={{ textAlign: "center", padding: "2rem 0", color: "var(--color-text-secondary)", fontSize: "14px" }}>
          <i className="ti ti-home-off" style={{ fontSize: "24px", display: "block", marginBottom: "8px" }} aria-hidden="true" />
          No properties found for your criteria. Try a different suburb or budget.
        </div>
      )}
    </>
  );
}
