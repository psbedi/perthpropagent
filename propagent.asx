  "Nedlands",
  "North Fremantle",
  "Peppermint Grove",
  "Perth CBD",
  "Shenton Park",
  "Subiaco",
  "Swanbourne",
  "West Perth",
  // South
  "Beaconsfield",
  "Bentley",
  "Bull Creek",
  "Canning Vale",
  "Cannington",
  "Cockburn Central",
  "Coolbellup",
  "East Victoria Park",
  "Hamilton Hill",
  "Harrisdale",
  "Highgate",
  "Huntingdale",
  "Kardinya",
  "Kenwick",
  "Leeming",
  "Lynwood",
  "Maddington",
  "Manning",
  "Melville",
  "Mount Pleasant",
  "Murdoch",
  "Myaree",
  "Parkwood",
